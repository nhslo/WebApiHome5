@model TaskItem
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="Id" type="hidden" />
<div class="mb-3">
    <label asp-for="Title" class="form-label">Название задачи</label>
    <input asp-for="Title" class="form-control form-control-lg" placeholder="Например, изучить HttpClient" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">Описание</label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Краткое описание задачи"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="form-check form-switch mb-4">
    <input asp-for="IsCompleted" class="form-check-input" />
    <label asp-for="IsCompleted" class="form-check-label">Задача выполнена</label>
</div>
